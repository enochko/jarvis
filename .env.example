# Jarvis Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# The Node.js edition (start-jarvis.cmd) loads this file automatically.

# --- Agent engine ---
# Shared secret between agent and channels. Generate once, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, the Node launcher generates a random one per run.
JARVIS_AGENT_SECRET=
# JARVIS_DEFAULT_MODEL=sonnet
# JARVIS_TASK_TIMEOUT=120
# JARVIS_WRITE_DIRS=~/Obsidian/aaa-claude/claude-outbox,~/Obsidian/aaa-claude/jarvis-memory
# JARVIS_LOG_DIR=~/Obsidian/aaa-claude/jarvis-logs
# JARVIS_AGENT_PORT=8000
# JARVIS_WEB_PORT=3000
# CLAUDE_PATH=   # only if claude is not found automatically

# --- Phase 1: Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=   # comma-separated Telegram user IDs (required when a token is set)

# --- Phase 3: Google Services ---
# Store OAuth credentials outside the vault and outside this repo.
# GOOGLE_CREDENTIALS_PATH=/path/outside/vault/google-credentials.json

# --- Optional: API keys for providers ---
# Not needed if using Claude Code via subscription (recommended).
# ANTHROPIC_API_KEY=sk-ant-...
