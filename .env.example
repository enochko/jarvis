# Jarvis Environment Variables
# Export these in your shell, or put them in your launchd plist
# EnvironmentVariables block. Never commit real values to git.
# Note: do not add inline comments after a value; some loaders keep them.

# --- Phase 1: Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USERS=123456789

# --- Agent engine <-> bot shared secret ---
# Generate once with: openssl rand -hex 32
# Must be identical for the agent and the bot.
JARVIS_AGENT_SECRET=paste_generated_secret_here

# --- Optional overrides ---
# JARVIS_AGENT_URL=http://127.0.0.1:8000
# JARVIS_DEFAULT_MODEL=sonnet
# JARVIS_TASK_TIMEOUT=120
# JARVIS_WRITE_DIRS=~/Obsidian/aaa-claude/claude-outbox,~/Obsidian/aaa-claude/jarvis-memory
# JARVIS_LOG_DIR=~/Obsidian/aaa-claude/jarvis-logs
# CLAUDE_PATH=/path/to/claude

# --- Phase 3: Google Services ---
# Store OAuth credentials outside the vault and outside this repo.
# GOOGLE_CREDENTIALS_PATH=/path/outside/vault/google-credentials.json

# --- Optional: API keys for providers ---
# Not needed if using Claude Code via subscription (recommended).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
